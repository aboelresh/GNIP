APP_NAME="Global News Intelligence Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gnip
DB_USERNAME=root
DB_PASSWORD=

# Cache & Queue
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# AI Providers (order determines priority with automatic failover)
# Provider order is configured in config/gnip.php
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60

# Feed Configuration
FEED_FETCH_INTERVAL=15
FEED_MAX_ITEMS=50
FEED_TIMEOUT=30

# Story Clustering
# Similarity threshold: 0.0 (never cluster) to 1.0 (exact match only)
CLUSTERING_THRESHOLD=0.3
CLUSTERING_TIME_WINDOW=72
CLUSTERING_MIN_SOURCES=1

# CORS - comma separated list of allowed origins
# Use * to allow all origins (not recommended for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Application locale
APP_LOCALE=en