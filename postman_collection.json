        {
          "name": "Latest Weekly Briefing",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/briefings/latest/weekly",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Latest Monthly Briefing",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/briefings/latest/monthly",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Latest Daily (Arabic)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/briefings/latest/daily?lang=ar",
              "query": [{ "key": "lang", "value": "ar" }]
            },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Get Briefing by ID",
          "request": {
