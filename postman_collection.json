          }
        },
        {
          "name": "Latest Daily Briefing",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/briefings/latest/daily",
            "header": [{ "key": "Accept", "value": "application/json" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns daily briefing', () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.data.type).to.eq('daily');",
                  "});"
                ]
              }
            }
